// MediBook schema for dbdiagram.io. Mirrors database/schema.sql.
// Paste at https://dbdiagram.io/d, then export as PNG or PDF named schema-diagram.
// Constraints are written into the column type text so they show in the exported image.

Project medibook {
  database_type: 'MySQL'
}

Table patients {
  id "int unsigned" [pk, increment, not null]
  full_name varchar(100) [not null]
  email "varchar(150)  UNIQUE" [not null, unique]
  phone varchar(20) [not null]
  created_at "datetime  DEFAULT CURRENT_TIMESTAMP" [not null]
}

Table doctors {
  id "int unsigned" [pk, increment, not null]
  full_name varchar(100) [not null]
  specialty varchar(80) [not null]
  consultation_fee "decimal(10,2)  CHECK >= 0" [not null]
  room varchar(10) [not null]
  created_at "datetime  DEFAULT CURRENT_TIMESTAMP" [not null]
}

Table appointments {
  id "int unsigned" [pk, increment, not null]
  patient_id "int unsigned" [not null, ref: > patients.id]
  doctor_id "int unsigned" [not null, ref: > doctors.id]
  appt_datetime "datetime  CHECK 09:00-16:30, every 30 min" [not null]
  status "enum('booked','cancelled')  DEFAULT 'booked'" [not null]
  amount_paid "decimal(10,2)  CHECK >= 0" [not null]
  refund_amount "decimal(10,2)  CHECK only when cancelled, <= amount_paid" [null]
  cancelled_at "datetime  CHECK only when cancelled" [null]
  booked_on "datetime  DEFAULT CURRENT_TIMESTAMP" [not null]
  active_slot "datetime  GENERATED: appt_datetime if booked, else NULL.  UNIQUE (doctor_id, active_slot) = no double booking" [null]
}

Note application_rules {
  '''
  Enforced in the application, not by a CHECK:
  max 12 appointments per doctor per day, bookings in the future only.
  '''
}
